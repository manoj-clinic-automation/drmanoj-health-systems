# Live data & secrets — never commit (see CLAUDE.md)
*.db
*.db.*
*.secret
*.env
*.token
ingest.env
# Operational detail and clinical term lists stay on the machine.
# THIS REPOSITORY IS PUBLIC - see tools/NO_SECRETS.py
*.local.txt
*.local.md
*.local.json
*.log
*.bak
*.bak-*
*.bak_*
# patch_fitlog_ist_and_steps.py and patch_workout_day_ist.py stamp their
# rollback copies '.bak.<stamp>'. Neither pattern above matches that
# spelling, and neither does the findstr gate in PUBLISH_HEALTH.bat, so a
# .bak of a sensitive file would have been committed to a PUBLIC repo.
*.bak.*
*.deployed-*
# a patcher's half-written copy of the file it was patching, if os.replace
# never ran. Same hazard class as a .bak.
*.tmp
# The briefs that commission this work quote the record they are about:
# molecule names, dates, findings. They are working notes, not deliverables,
# and THIS REPOSITORY IS PUBLIC. 2026-09-14: the Phase J brief named two
# molecules and a Holter result, and `git add -A` would have taken it.
# NOTE: CLAUDE_CODE_PROMPT_pain_v1.md and _fitlog.md were committed before
# this rule existed and are still tracked - ignoring a path does not untrack
# it. See the CHANGELOG entry for 2026-09-14.
fitlog-ingest/CLAUDE_CODE_PROMPT_*.md

# Runtime junk
__pycache__/
*.pyc
venv/
uploads/
nohup.out

# RxGuard source-sync cache and lock (downloaded public data, rebuilt on the server)
knowledge/cache/
.kb_sync.lock

# Local deploy bundles (copies of files that live in the app folders)
_deploy/

# scan_lab working files: synthetic photographs and their measurements are
# regenerated by make_images.py, not carried in the repository.
gutlog/scan_lab/*.bin
gutlog/scan_lab/*.npy
gutlog/scan_lab/*.png
gutlog/scan_lab/*.json

# negative-control scratch builds (tools/NEGATIVE_CONTROL.py writes these beside app.py)
gutlog/_nc_*.py
*/_nc_*.py

# test_ui_now.py screenshots (run output, not source)
gutlog/ui_*.png
